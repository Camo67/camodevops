# Camodevops.online — Docker Environment Variables
# Copy to .env and fill in your values

# ─── Server paths ──────────────────────────────────────────────────────────────
# Absolute path to the agentic-harness source on this machine
HARNESS_DIR=/home/camo67/agentic-harness

# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=agentic-harness-verify

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─── Local LLM — Hermes (native on host, reached via host.docker.internal) ────
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=hermes3:8b

# ─── AI Providers ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
DEEPINFRA_API_KEY=

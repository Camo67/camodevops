{
  // Cloudflare Worker serving the generated static site.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camodevops",
  "compatibility_date": "2026-06-16",
  "main": "sos-router.js",
  "assets": {
    "directory": "./output",
    "binding": "ASSETS",
    // Serve pretty URLs (/architecture -> architecture.html) and a 404 page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Path overlay on the Command Center's custom domain: only /app* comes to
  // this worker; sos-camodevops keeps every other path on that hostname.
  // Also handles Telegram bot webhook/mini app routes and the mail API.
  "routes": [
    { "pattern": "sos.camodevops.online/app*", "zone_name": "camodevops.online" },
    { "pattern": "sos.camodevops.online/bot*", "zone_name": "camodevops.online" },
    { "pattern": "sos.camodevops.online/webhook*", "zone_name": "camodevops.online" },
    { "pattern": "sos.camodevops.online/api/mail*", "zone_name": "camodevops.online" }
  ],
  // Unified mail store — every mailbox on every configured domain (see the
  // `domains` table) lands here. Inbound rows are written by the `email()`
  // handler (wired up via Cloudflare Email Routing in the dashboard, not
  // here — see EMAIL_SETUP.md); outbound rows are written when /api/mail/send
  // or a reply goes out through Resend.
  "d1_databases": [
    { "binding": "MAIL_DB", "database_name": "camodevops-mail", "database_id": "4cf635fe-9b9e-43d3-bad6-78c8ceec1247" }
  ],
  // Secrets (set via `wrangler secret put <NAME>`, never committed):
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_WEBHOOK_SECRET — Telegram bot
  //   RESEND_API_KEY   — outbound send (api.resend.com)
  //   ANTHROPIC_API_KEY — Kyra's draft-reply generation; drafting is skipped
  //                       silently if unset, mail still arrives fine
  //
  // NOTE: `npm run deploy` runs plain `wrangler deploy` (no --env flag), so
  // vars belong at this top level, not under a named "env" block — a named
  // block is only applied when you explicitly deploy with --env <name>.
  "vars": {
    "TELEGRAM_BOT_ACTIVE": "true"
    // "MAIL_FORWARD_TO": "you@example.com" — optional: also forward every
    // inbound message to a personal address while the inbox UI is new.
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
